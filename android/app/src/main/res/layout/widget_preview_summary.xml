<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingHorizontal="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="78dp" android:layout_height="wrap_content" android:gravity="center"
            android:paddingVertical="12dp" android:text="Income" android:textColor="@color/widget_tab_on" android:textSize="13sp" />
        <TextView android:layout_width="78dp" android:layout_height="wrap_content" android:gravity="center"
            android:paddingVertical="12dp" android:text="Expenses" android:textColor="@color/widget_tab_off" android:textSize="13sp" />
        <TextView android:layout_width="78dp" android:layout_height="wrap_content" android:gravity="center"
            android:paddingVertical="12dp" android:text="Total" android:textColor="@color/widget_tab_off" android:textSize="13sp" />
    </LinearLayout>

    <!-- RemoteViews allow no plain View; an empty FrameLayout draws the line. -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/widget_line" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingVertical="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This Month"
                android:textColor="#FF000000" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2,500.00"
                android:textColor="#FF000000" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▲ 500.00 (25%)"
                android:textColor="@color/widget_good" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="vs. MoM"
                android:textColor="@color/widget_muted" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
