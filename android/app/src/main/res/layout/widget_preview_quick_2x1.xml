<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel_red"
    android:orientation="horizontal"
    android:padding="4dp">

    <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:layout_weight="1"
        android:background="@drawable/widget_tile_red" android:importantForAccessibility="no" android:scaleType="center"
        android:src="@drawable/ic_add" android:tint="#FFFFFFFF" />
    <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:layout_weight="1"
        android:background="@drawable/widget_tile_red" android:importantForAccessibility="no" android:scaleType="center"
        android:src="@drawable/ic_remove" android:tint="#FFFFFFFF" />
</LinearLayout>
