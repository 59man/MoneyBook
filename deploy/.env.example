# Copy to .env (gitignored). Everything is optional.
# Optional: use your own API key (at least 32 characters, openssl rand -hex 32). Empty = the server makes one and shows it on its page.
MB_API_KEY=
# Port the server listens on (host networking); the server itself only answers trusted networks (below)
MB_HOST_PORT=8095
# Postgres listens on the host loopback (host networking); change if 5432 is taken
MB_PG_PORT=5432
# Time zone of the nightly 03:00 backup
TZ=Etc/UTC
# Comma-separated CIDRs allowed to talk to the server. Empty = Tailscale + loopback: 100.64.0.0/10,127.0.0.0/8,::1/128
MB_TRUSTED_NETWORKS=
# Extra Host names accepted besides IP addresses and localhost (comma-separated)
# MB_ALLOWED_HOSTS=
