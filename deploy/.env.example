# Copy to .env (gitignored) and fill in. Placeholders only.
POSTGRES_PASSWORD=change-me
# openssl rand -base64 48
MB_JWT_SECRET=
# The key you paste into the app (More, Sync). At least 32 characters: openssl rand -hex 32
MB_API_KEY=
# Host port the API is published on, on 127.0.0.1 only (Tailscale serve proxies it)
MB_HOST_PORT=8095
# id -u / id -g of the host user that owns ./backups
BACKUP_UID=1000
BACKUP_GID=1000
# Time zone of the nightly 03:00 backup
TZ=Etc/UTC
